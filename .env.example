# ==============================================================================
# Progressive Credential Loading (PCL) Configuration
# Repository: automated-eval-dataset-generator
# ==============================================================================
#
# TIER 1: ZERO-SETUP / LOCAL DEV / CI (Default)
# - No OpenAI API key required.
# - System runs in Mock Mode using high-quality template-based evaluation generation.
#
# TIER 2: LOCAL DEV WITH LIVE AI
# - Supply an OpenAI API key (sk-...) to activate live GPT-4o-mini synthetic dataset
#   generation across multi-hop QA, adversarial traps, and edge cases.
#
# TIER 3: PRODUCTION KUBERNETES DEPLOYMENT
# - Inject credentials via Kubernetes Secrets or Helm values.
#
# ── AI Provider ──────────────────────────────────────────────────────────────
# UNSET or sk-dummy (default): Deterministic template generation (CI-safe)
# SET to real sk-... key: Live GPT-4o-mini eval dataset synthesis
OPENAI_API_KEY=

# ── Port & Storage ───────────────────────────────────────────────────────────
PORT=8000
OUTPUT_DIR=datasets
